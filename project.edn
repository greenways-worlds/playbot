{:hara/type :project
 :hara/version "1.0.0"
 :project/id greenways-worlds/playbot
 :project/version "1.1.0"
 :project/source-paths []
 :project/test-paths []
 :project/extension-paths []
 :project/capabilities [:canvas/webgl2 :input/pointer :ui/surfaces]
 :project/world
 {:world/version "1.0.0"
  :world/title "Playbot"
  :world/background "#10121a"
  :world/camera {:world/position [4 2.6 4]
                 :world/target [0 0.8 0]
                 :world/fov 75}
  :world/layers [{:world/id playbot
                  :world/asset "world/playbot/lod-meta.json"
                  :world/transform {:world/position [0 0 0]
                                    :world/rotation [180 0 0]
                                    :world/scale 1}}]
  :world/touchpoints
  [{:touchpoint/id music-studio
    :touchpoint/label "Open Studio"
    :touchpoint/description "Bring local recordings into a Hara-carried music workspace"
    :touchpoint/surface :studio
    :touchpoint/presentation :panel
    :touchpoint/transform {:world/position [0 1.05 0]
                           :world/rotation [0 0 0]
                           :world/scale 1}}]
  :world/imports []}}
